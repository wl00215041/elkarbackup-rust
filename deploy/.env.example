# Copy to .env next to docker-compose.yml and adjust.

# Database password; use URL safe characters (letters, digits, - _ . ~).
POSTGRES_PASSWORD=change-me

# Time zone the policy schedules are evaluated in.
TZ=Asia/Taipei

# Address and port the web interface is published on. Keep 127.0.0.1 and put
# a TLS terminating reverse proxy in front for remote access.
ELKARBACKUP_BIND=127.0.0.1
ELKARBACKUP_PORT=8080

# Host directory (or volume name) for keys, scripts, logs and backups.
# ELKARBACKUP_DATA=/srv/elkarbackup

# RUST_LOG=info
